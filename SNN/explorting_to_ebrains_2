def encode_rate(
    x,
    simulation_time=100.0,
    max_rate=100.0
):

    x = x.flatten().astype(np.float32)

    # Normalise
    x_min = x.min()
    x_max = x.max()

    if x_max > x_min:
        x = (x - x_min) / (x_max - x_min)
    else:
        x = np.zeros_like(x)

    spike_times = []

    for value in x:

        rate = value * max_rate

        if rate <= 0:
            spike_times.append([])
            continue

        isi = 1000.0 / rate

        times = np.arange(
            isi,
            simulation_time,
            isi
        )

        spike_times.append(times.tolist())

    return spike_times

    



















